<%# Inside the invoice form. Each cost carries its rows as templates; the billable
    Stimulus controller hands a ticked cost's rows to the line-items controller. %>
<%= turbo_frame_tag dom_id(Current.organization, :billable_expenses) do %>
  <% if @costs.any? %>
    <fieldset class="billable-panel">
      <legend>Billable expenses for <%= @contact.name %></legend>
      <div class="field">
        <label for="billable_markup">Markup %</label>
        <input type="number" id="billable_markup" value="<%= @markup %>" min="0" step="0.5" inputmode="decimal" style="max-width:120px;"
               data-billable-target="markup" data-action="change->billable#markupChanged">
        <span class="field-help">On each line's price when you tick it. Changing it clears what you ticked.</span>
      </div>
      <ul class="billable-list">
        <% @costs.each do |cost| %>
          <% rows = @rows[cost] %>
          <li data-cost-id="<%= cost.id %>">
            <label>
              <input type="checkbox" data-cost-id="<%= cost.id %>" data-action="change->billable#toggle">
              <span class="billable-when"><%= cost.date.strftime("%b %-d, %Y") %></span>
              <span class="billable-who"><%= cost.counterparty %></span>
              <span class="billable-what"><%= cost.line_items.map(&:description).compact_blank.join(", ").presence || cost.label %></span>
              <span class="billable-amount"><%= money(rows.sum(&:amount)) %></span>
            </label>
            <%= fields_for :document, @invoice do |f| %>
              <% rows.each do |line| %>
                <template><%= f.fields_for :line_items, line, child_index: "NEW_RECORD" do |li_form| %><%= render "shared/line_item_row", li_form: li_form, accounts: @accounts, tax_rates: @tax_rates %><% end %></template>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </fieldset>
  <% end %>
<% end %>
