<header class="page-header">
  <h1><%= @contact.name %></h1>
  <%= link_to "Edit", edit_contact_path(@contact), class: "btn btn-secondary" %>
</header>

<dl class="app-form" style="display:grid;grid-template-columns:auto 1fr;gap:8px 20px;">
  <dt style="font-weight:600;color:var(--text-muted);font-size:13px;">Kind</dt>       <dd style="margin:0;"><%= @contact.kind %></dd>
  <dt style="font-weight:600;color:var(--text-muted);font-size:13px;">Email</dt>      <dd style="margin:0;"><%= @contact.email %></dd>
  <dt style="font-weight:600;color:var(--text-muted);font-size:13px;">Phone</dt>      <dd style="margin:0;"><%= @contact.phone %></dd>
  <% if [@contact.address, @contact.city, @contact.postal_code].any?(&:present?) %>
    <dt style="font-weight:600;color:var(--text-muted);font-size:13px;">Address</dt>
    <dd style="margin:0;">
      <%= simple_format [@contact.address, [@contact.city, @contact.region, @contact.postal_code].compact_blank.join(", "), @contact.country].compact_blank.join("\n") %>
    </dd>
  <% end %>
  <% if @contact.tax_number.present? %>
    <dt style="font-weight:600;color:var(--text-muted);font-size:13px;">Tax #</dt>    <dd style="margin:0;"><%= @contact.tax_number %></dd>
  <% end %>
  <% if @contact.notes.present? %>
    <dt style="font-weight:600;color:var(--text-muted);font-size:13px;">Notes</dt>    <dd style="margin:0;"><%= simple_format @contact.notes %></dd>
  <% end %>
</dl>

<section style="margin-top:32px;">
  <h2 style="font-size:15px;font-weight:600;margin:0 0 12px;">
    Activity
    <% if @outstanding.positive? %><span class="muted" style="font-weight:400;font-size:13px;">· <%= money(@outstanding) %> outstanding</span><% end %>
  </h2>
  <% if @documents.any? %>
    <table class="data-table">
      <thead><tr><th>Date</th><th>Document</th><th>Reference</th><th>Status</th><th class="num">Total</th><th class="num">Balance due</th></tr></thead>
      <tbody>
        <% @documents.each do |document| %>
          <tr id="<%= dom_id(document) %>">
            <td><%= document.date.iso8601 %></td>
            <td><%= link_to document.label, document_path_for(document) %></td>
            <td class="muted"><%= document.reference %></td>
            <td><%= status_badge(document.status) %></td>
            <td class="num"><%= money(document.total) %></td>
            <td class="num"><%= document.settleable? ? money(document.balance_due) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">No documents for this contact yet.</p>
  <% end %>
</section>
