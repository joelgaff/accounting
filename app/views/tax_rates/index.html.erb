<header class="page-header">
  <h1>Tax rates</h1>
  <%= link_to "New tax rate", new_tax_rate_path, class: "btn btn-primary" %>
</header>

<% if @tax_rates.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th class="num">Rate</th>
        <th>Xero code</th>
        <th>Sales tax liability</th>
        <th>Purchase tax asset</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tax_rates.each do |t| %>
        <tr>
          <td><%= t.name %></td>
          <td class="num"><%= number_to_percentage(t.rate * 100, precision: 2) %></td>
          <td class="muted"><%= t.xero_tax_type %></td>
          <td><%= t.liability_account&.name %></td>
          <td><%= t.asset_account&.name %></td>
          <td>
            <%= link_to "Edit", edit_tax_rate_path(t) %>
            <%= button_to "Delete", tax_rate_path(t), method: :delete, class: "btn btn-secondary",
                form: { data: { turbo_confirm: "Delete #{t.name}?" }, style: "display:inline" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">
    No tax rates yet. <%= link_to "Add one", new_tax_rate_path %> or leave empty if your business doesn't collect sales tax.
  </p>
<% end %>
