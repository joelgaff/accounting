<%= form_with model: category, class: "app-form", data: { controller: "nested-rows", nested_rows_index_value: category.options.size } do |f| %>
  <% if category.errors.any? %>
    <div class="form-errors">
      <ul><% category.errors.full_messages.each { |m| %><li><%= m %></li><% } %></ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, "Category name" %>
    <%= f.text_field :name, placeholder: "e.g. Event Year", autofocus: true %>
  </div>

  <div class="field">
    <label class="check-row">
      <%= f.check_box :active %>
      <span>Active <span class="muted">— shown on every line sheet (at most <%= TrackingCategory::MAX_ACTIVE %> active at once)</span></span>
    </label>
  </div>

  <fieldset class="line-items">
    <legend>Options</legend>
    <table class="data-table sheet">
      <thead>
        <tr><th>Option</th><th style="width:90px;">Active</th><th style="width:44px;"></th></tr>
      </thead>
      <tbody data-nested-rows-target="rows">
        <%= f.fields_for :options do |of| %>
          <%= render "tracking_categories/option_row", of: of %>
        <% end %>
      </tbody>
    </table>
    <template data-nested-rows-target="template">
      <%= f.fields_for :options, TrackingOption.new(active: true), child_index: "NEW_RECORD" do |of| %>
        <%= render "tracking_categories/option_row", of: of %>
      <% end %>
    </template>
    <button type="button" class="btn btn-secondary" data-action="nested-rows#add">+ Add option</button>
  </fieldset>

  <div class="form-actions">
    <%= f.submit (category.new_record? ? "Add category" : "Save changes"), class: "btn btn-primary" %>
    <%= link_to "Cancel", tracking_categories_path, class: "btn btn-secondary" %>
  </div>
<% end %>
