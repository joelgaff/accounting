<header class="page-header">
  <h1>Tracking categories</h1>
  <div style="display:flex;gap:8px;">
    <%= link_to "← Settings", settings_path, class: "btn btn-secondary" %>
    <%= link_to "New category", new_tracking_category_path, class: "btn btn-primary" %>
  </div>
</header>

<p class="muted" style="margin:0 0 16px;font-size:13px;">
  Tag any line with one option from each category, such as <em>Event Year: 2026</em> and <em>Class: EE Timing</em>,
  and read the Profit &amp; Loss by option. At most <%= TrackingCategory::MAX_ACTIVE %> categories are active at once, as in Xero.
</p>

<% if @categories.any? %>
  <table class="data-table">
    <thead><tr><th>Category</th><th>Options</th><th>Active</th><th></th></tr></thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr id="<%= dom_id(category) %>" class="<%= 'muted' unless category.active? %>">
          <td><%= link_to category.name, edit_tracking_category_path(category) %></td>
          <td><%= category.options.map { |o| o.active? ? o.name : "#{o.name} (off)" }.join(", ") %></td>
          <td><%= category.active? ? "yes" : "no" %></td>
          <td class="num"><%= button_to "Remove", tracking_category_path(category), method: :delete, class: "btn btn-secondary", form: { data: { turbo_confirm: "Remove “#{category.name}”?" } }, style: "padding:2px 8px;font-size:12px;" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No tracking categories yet. Xero imports create them from the TrackingName columns, or add one here.</p>
<% end %>
