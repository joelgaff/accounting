Hi <%= @invoice.counterparty %>,

<% if @body.present? %><%= @body %>

<% else %>Please find your invoice below.

<% end %>
---
Invoice #<%= @invoice.id %>
From:     <%= @invoice.organization.name %>
To:       <%= @invoice.counterparty %>
Due date: <%= @invoice.invoice.due_date.strftime("%b %-d, %Y") %>

Services rendered .......... $<%= '%.2f' % (@invoice.subtotal) %>
<% if @invoice.tax_amount.positive? %>Tax (<%= @invoice.invoice.tax_rate_display %>) . $<%= '%.2f' % @invoice.tax_amount %>
<% end %>Total due .................. $<%= '%.2f' % @invoice.total %>
