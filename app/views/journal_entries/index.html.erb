<header class="page-header">
  <h1>Journal</h1>
  <%= link_to "New journal entry", new_journal_entry_path, class: "btn btn-primary" %>
</header>

<%= render "documents/status_filter", statuses: [] %>

<% if @documents.any? %>
  <table class="data-table">
    <thead>
      <tr><th>Date</th><th>Narrative</th><th>Reference</th><th class="num">Amount</th></tr>
    </thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr id="<%= dom_id(document) %>" class="<%= 'muted' if document.voided? %>">
          <td><%= document.date.iso8601 %></td>
          <td><%= link_to document.journal_entry.narrative, journal_entry_path(document) %></td>
          <td class="muted"><%= document.reference %></td>
          <td class="num"><%= money(document.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
<% else %>
  <p class="empty-state">No journal entries yet. <%= link_to "Post one", new_journal_entry_path %>.</p>
<% end %>
