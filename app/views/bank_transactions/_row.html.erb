<%# One statement line: a single-height row, plus a panel row beneath it that
    opens only when a tab is clicked. Both live in one tbody so a stream
    replace swaps them together. %>
<% default_segment = candidates.any? ? "match" : "create" %>
<%= tag.tbody id: dom_id(txn), class: "recon-item #{'muted' if txn.ignored?}", data: { controller: "segments", segments_default_value: default_segment, action: "keydown->segments#keydown" } do %>
  <tr class="recon-row" tabindex="0">
    <td class="recon-date"><%= txn.posted_on.iso8601 %></td>
    <td class="recon-payee">
      <strong><%= txn.display_payee %></strong>
      <div class="recon-meta muted">
        <span class="recon-bank"><%= txn.bank_account.name %></span>
        <% if txn.payee.present? && txn.description.present? && txn.description != txn.payee %> · <%= txn.description %><% end %>
        <% if txn.reference.present? %> · <%= txn.reference %><% end %>
      </div>
    </td>
    <td class="recon-amount num <%= txn.deposit? ? 'pos' : 'neg' %>"><%= signed_money(txn.amount) %></td>
    <td class="recon-status">
      <%= status_badge(txn.partial? ? "partial" : txn.status) %>
      <% if txn.partial? %><div class="muted" style="font-size:11px;"><%= money(txn.remaining) %> left</div><% end %>
    </td>
    <td class="recon-actions">
      <% if txn.unmatched? %>
        <div class="recon-strip">
          <% if suggestion&.confident? %>
            <div class="suggestion" title="<%= suggestion.label %>">
              <span class="suggestion-text">→ <%= suggestion.label %><%= coding_chips(suggestion.coding) %></span>
              <%= button_to "OK", accept_suggestion_bank_transaction_path(txn), params: { kind: suggestion.kind, target_id: suggestion.target&.id }.compact, class: "btn btn-primary" %>
            </div>
          <% end %>
          <div class="segments" role="tablist">
            <% if candidates.any? %>
              <button type="button" role="tab" aria-selected="false" data-segments-target="tab" data-segment="match" data-action="segments#select">Match</button>
            <% end %>
            <% if candidates_index.pool_for(txn).any? %>
              <button type="button" role="tab" aria-selected="false" data-segments-target="tab" data-segment="split" data-action="segments#select">Split</button>
            <% end %>
            <button type="button" role="tab" aria-selected="false" data-segments-target="tab" data-segment="create" data-action="segments#select"><%= txn.deposit? ? "Deposit" : "Expense" %></button>
            <button type="button" role="tab" aria-selected="false" data-segments-target="tab" data-segment="transfer" data-action="segments#select">Transfer</button>
            <%= button_to "Ignore", ignore_bank_transaction_path(txn), class: "btn btn-secondary segments-aside" %>
          </div>
        </div>
      <% else %>
        <%= render "bank_transactions/result", txn: txn %>
      <% end %>
    </td>
  </tr>
  <% if txn.unmatched? %>
    <tr class="recon-panel" hidden data-segments-target="drawer">
      <td colspan="5">
        <div id="<%= dom_id(txn, :error) %>"></div>
        <% if candidates.any? %>
          <div data-segments-target="panel" data-segment="match" hidden><%= render "bank_transactions/panels/match", txn: txn, candidates: candidates %></div>
        <% end %>
        <% if candidates_index.pool_for(txn).any? %>
          <div data-segments-target="panel" data-segment="split" hidden><%= render "bank_transactions/panels/split", txn: txn, pool: candidates_index.pool_for(txn) %></div>
        <% end %>
        <div data-segments-target="panel" data-segment="create" hidden><%= render "bank_transactions/panels/create", txn: txn, hint: local_assigns[:hint] %></div>
        <div data-segments-target="panel" data-segment="transfer" hidden><%= render "bank_transactions/panels/transfer", txn: txn, candidates: candidates %></div>
      </td>
    </tr>
  <% end %>
<% end %>
