<%= turbo_stream.replace @txn, partial: "bank_transactions/row", locals: { txn: @txn, candidates: @candidates.for(@txn), suggestion: @suggestions.top(@txn), candidates_index: @candidates } %>
<% if @sibling %>
  <%= turbo_stream.replace @sibling, partial: "bank_transactions/row", locals: { txn: @sibling, candidates: @candidates.for(@sibling), suggestion: @suggestions.top(@sibling), candidates_index: @candidates } %>
<% end %>
<%= turbo_stream.update dom_id(Current.organization, :unmatched_count), Current.organization.bank_transactions.unmatched.count.to_s %>
<% @summary.each do |row| %>
  <%= turbo_stream.replace dom_id(row.bank_account, :recon_summary), partial: "bank_transactions/summary_card", locals: { row: row } %>
<% end %>
