<% [ @txn, @sibling ].compact.each do |row| %>
  <% if @leaving.include?(row) %>
    <%= turbo_stream.remove row %>
  <% else %>
    <%= turbo_stream.replace row, partial: "bank_transactions/row", locals: { txn: row, candidates: @candidates.for(row), suggestion: @suggestions.top(row), hint: @memory.for(row), candidates_index: @candidates } %>
  <% end %>
<% end %>
<%= turbo_stream.update dom_id(Current.organization, :unmatched_count), Current.organization.bank_transactions.unmatched.count.to_s %>
<% @summary.each do |row| %>
  <%= turbo_stream.replace dom_id(row.bank_account, :recon_summary), partial: "bank_transactions/summary_card", locals: { row: row } %>
<% end %>
