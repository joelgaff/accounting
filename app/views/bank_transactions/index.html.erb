<header class="page-header">
  <h1>Bank reconciliation
    <span id="<%= dom_id(Current.organization, :unmatched_count) %>" class="muted" style="font-size:14px;font-weight:400;"><%= @unmatched_count %></span>
    <span class="muted" style="font-size:14px;font-weight:400;">unmatched</span>
  </h1>
  <div style="display:flex;gap:8px;">
    <%= link_to "Rules", bank_rules_path, class: "btn btn-secondary" %>
    <%= link_to "Import statement", new_imports_bank_path, class: "btn btn-primary" %>
  </div>
</header>

<% if @summary.any? %>
  <section class="kpi-grid recon-summary">
    <% @summary.each do |row| %>
      <%= render "bank_transactions/summary_card", row: row %>
    <% end %>
  </section>
<% end %>

<%# Two rows of chips: which account, then which status. Each keeps the other's choice. %>
<nav class="chips" aria-label="Bank account">
  <% current_bank = params[:bank_account_id].to_s %>
  <%= link_to "All accounts", bank_transactions_path(status: params[:status].presence), class: ("active" if current_bank.blank?), "aria-current": ("page" if current_bank.blank?) %>
  <% @summary.each do |row| %>
    <% on = current_bank == row.bank_account.id.to_s %>
    <%= link_to "#{row.bank_account.name} · #{row.unmatched_count}", bank_transactions_path(bank_account_id: row.bank_account.id, status: params[:status].presence), class: ("active" if on), "aria-current": ("page" if on) %>
  <% end %>
</nav>
<nav class="chips" aria-label="Status">
  <% current_status = params[:status].to_s %>
  <%= link_to "All", bank_transactions_path(bank_account_id: params[:bank_account_id].presence), class: ("active" if current_status.blank?), "aria-current": ("page" if current_status.blank?) %>
  <% BankTransaction::STATUSES.each do |s| %>
    <% on = current_status == s %>
    <%= link_to s.titleize, bank_transactions_path(bank_account_id: params[:bank_account_id].presence, status: s), class: ("active" if on), "aria-current": ("page" if on) %>
  <% end %>
</nav>

<datalist id="<%= dom_id(Current.organization, :contact_names) %>">
  <% @contact_names.each do |name| %><option value="<%= name %>"></option><% end %>
</datalist>

<%= turbo_frame_tag dom_id(Current.organization, :bank_transactions) do %>
  <% if @transactions.any? %>
    <table class="data-table recon-table">
      <thead>
        <tr>
          <th class="recon-date">Date</th>
          <th>Payee</th>
          <th class="num">Amount</th>
          <th>Status</th>
          <th class="recon-actions">Actions</th>
        </tr>
      </thead>
      <% @transactions.each do |txn| %>
        <%= render "bank_transactions/row", txn: txn, candidates: @candidates.for(txn), suggestion: @suggestions.top(txn), candidates_index: @candidates %>
      <% end %>
    </table>
    <%= render "shared/pagination" %>
  <% else %>
    <p class="empty-state">No transactions match this filter.</p>
  <% end %>
<% end %>

<p class="muted" style="font-size:12px;margin-top:16px;">
  A line that is an invoice payment net of a processor fee can't be split here yet: record the fee as an expense
  and match the rest, or edit the invoice.
</p>
