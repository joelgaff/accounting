<header class="page-header">
  <h1>Balance Sheet</h1>
  <span class="muted">As of <%= @as_of.strftime("%b %-d, %Y") %></span>
</header>

<%= form_with url: reports_balance_sheet_path, method: :get, class: "app-form filter-bar" do |f| %>
  <div class="field" style="margin:0;">
    <%= f.label :as_of, "As of" %>
    <%= f.date_field :as_of, value: @as_of %>
  </div>
  <%= f.submit "Run", class: "btn btn-primary" %>
<% end %>

<div class="report-columns">
  <section class="account-group">
    <h2>Assets</h2>
    <table class="data-table">
      <tbody>
        <% @report.asset_rows.each do |r| %>
          <tr>
            <td><%= r.account.code %></td>
            <td><%= r.account.name %></td>
            <td class="num">$<%= number_with_precision(r.amount, precision: 2, delimiter: ",") %></td>
          </tr>
        <% end %>
        <tr class="subtotal">
          <td></td><td>Total assets</td>
          <td class="num">$<%= number_with_precision(@report.total_assets, precision: 2, delimiter: ",") %></td>
        </tr>
      </tbody>
    </table>
  </section>

  <div>
    <section class="account-group">
      <h2>Liabilities</h2>
      <table class="data-table">
        <tbody>
          <% @report.liability_rows.each do |r| %>
            <tr>
              <td><%= r.account.code %></td>
              <td><%= r.account.name %></td>
              <td class="num">$<%= number_with_precision(r.amount, precision: 2, delimiter: ",") %></td>
            </tr>
          <% end %>
          <tr class="subtotal">
            <td></td><td>Total liabilities</td>
            <td class="num">$<%= number_with_precision(@report.total_liabilities, precision: 2, delimiter: ",") %></td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="account-group">
      <h2>Equity</h2>
      <table class="data-table">
        <tbody>
          <% @report.equity_rows.each do |r| %>
            <tr>
              <td><%= r.account.code %></td>
              <td><%= r.account.name %></td>
              <td class="num">$<%= number_with_precision(r.amount, precision: 2, delimiter: ",") %></td>
            </tr>
          <% end %>
          <tr>
            <td></td>
            <td>Retained earnings</td>
            <td class="num">$<%= number_with_precision(@report.retained_earnings, precision: 2, delimiter: ",") %></td>
          </tr>
          <% @report.prior_year_rows.each do |r| %>
            <tr class="detail">
              <td></td>
              <td class="muted"><%= r.year %></td>
              <td class="num muted">$<%= number_with_precision(r.amount, precision: 2, delimiter: ",") %></td>
            </tr>
          <% end %>
          <tr>
            <td></td>
            <td>Current year earnings <span class="muted"><%= @report.current_year_start.strftime("%b %-d") %> – <%= @as_of.strftime("%b %-d, %Y") %></span></td>
            <td class="num">$<%= number_with_precision(@report.current_year_earnings, precision: 2, delimiter: ",") %></td>
          </tr>
          <tr class="subtotal">
            <td></td><td>Total liab. + equity</td>
            <td class="num">$<%= number_with_precision(@report.total_liabilities_and_equity, precision: 2, delimiter: ",") %></td>
          </tr>
        </tbody>
      </table>
    </section>
  </div>
</div>

<% unless @report.balanced? %>
  <div class="notice" style="margin-top:20px;">
    <p><strong>Balance sheet does NOT balance</strong> — assets − (liabilities + equity + net income) = <strong>$<%= number_with_precision(@report.total_assets - @report.total_liabilities_and_equity, precision: 2, delimiter: ",") %></strong>. This usually means an opening balance or a manual entry isn't right.</p>
  </div>
<% end %>
