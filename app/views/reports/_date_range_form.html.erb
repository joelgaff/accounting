<%= form_with url: url, method: :get, class: "app-form filter-bar" do |f| %>
  <div class="field" style="margin:0;">
    <%= f.label :from, "From" %>
    <%= f.date_field :from, value: from %>
  </div>
  <div class="field" style="margin:0;">
    <%= f.label :to, "To" %>
    <%= f.date_field :to, value: to %>
  </div>
  <%= f.submit "Run", class: "btn btn-primary" %>
<% end %>
