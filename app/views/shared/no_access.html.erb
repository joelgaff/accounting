<div class="guest-shell">
  <main>
    <div class="guest-card">
      <div class="guest-brand"><span><%= render "shared/logo_mark", size: 20 %></span>LEDGER</div>
      <h1>You don't have access to Accounting.</h1>
      <p class="muted" style="margin:0 0 20px;font-size:12.5px;">
        Your account isn't granted the Accounting app yet. Ask an administrator to enable it
        from the Launchpad admin, then reload.
      </p>
      <div class="form-actions">
        <%= link_to "Back to Launchpad", Rails.application.config.x.launchpad_base_url, class: "btn btn-primary", style: "width:100%;text-align:center;" %>
      </div>
    </div>
  </main>
</div>
