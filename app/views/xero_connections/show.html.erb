<% if @connection&.running? %><% content_for :head do %><meta http-equiv="refresh" content="5"><% end %><% end %>
<header class="page-header">
  <h1>Xero</h1>
  <%= link_to "← Settings", settings_path, class: "btn btn-secondary" %>
</header>

<% if @connection.nil? %>
  <div class="notice notice-info">
    <p><strong>Connect this app to your Xero organisation</strong> and it pulls the whole history straight from Xero's API: chart of accounts, tax rates, contacts, tracking categories, every sales invoice and bill with its lines, tracking and payments, and every other journal (spend and receive money, transfers, manual journals, conversion balances).</p>
    <% if @configured %>
      <p>Xero will ask you to sign in and approve read-only access.</p>
    <% else %>
      <p>Before this works, create an app at <a href="https://developer.xero.com/app/manage" target="_blank" rel="noopener">developer.xero.com</a> (Web app, redirect URI <code><%= callback_xero_connection_url %></code>) and add its client id and secret to the credentials as <code>xero.client_id</code> and <code>xero.client_secret</code>.</p>
    <% end %>
  </div>
  <%# A plain form: Turbo can't follow the redirect to login.xero.com. %>
  <%= button_to "Connect to Xero", connect_xero_connection_path, class: "btn btn-primary", disabled: !@configured, form: { data: { turbo: false } } %>
<% else %>
  <%= render "xero_connections/status", connection: @connection %>

  <h2 style="font-size:15px;font-weight:600;margin:24px 0 12px;">Import from Xero</h2>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">
    Every step is idempotent: re-running updates what changed in Xero and never duplicates. Leave the date blank for everything since your Xero conversion date.
  </p>
  <%= form_with url: xero_connection_path, method: :patch, class: "app-form filter-bar" do |f| %>
    <div class="field" style="margin:0;">
      <%= f.label :import_from, "From date (optional)" %>
      <%= f.date_field :import_from, value: @connection.import_from %>
    </div>
    <%= f.submit (@connection.last_import_at ? "Run again" : "Run import"), class: "btn btn-primary", disabled: @connection.running? %>
  <% end %>

  <% if @connection.steps.any? %>
    <table class="data-table" style="margin-top:16px;max-width:720px;">
      <thead><tr><th>Step</th><th class="num">Created</th><th class="num">Updated</th><th class="num">Skipped</th><th>Notes</th></tr></thead>
      <tbody>
        <% @connection.steps.each do |s| %>
          <tr>
            <td><%= s["step"] %><%= " …" unless s["done"] %></td>
            <td class="num"><%= s["created"] %></td>
            <td class="num"><%= s["updated"] %></td>
            <td class="num"><%= s["skipped"] %></td>
            <td class="muted" style="font-size:12px;white-space:normal;"><%= s["errors"].to_a.first(5).join("; ") %><%= " (+#{s['errors'].size - 5} more)" if s["errors"].to_a.size > 5 %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if (summary = @connection.summary) %>
    <h2 style="font-size:15px;font-weight:600;margin:24px 0 12px;">Books after the last import</h2>
    <table class="data-table" style="max-width:520px;">
      <tbody><% summary.each do |k, v| %><tr><td class="muted"><%= k %></td><td><%= v %></td></tr><% end %></tbody>
    </table>
  <% end %>

  <div style="margin-top:32px;">
    <%= button_to "Disconnect", xero_connection_path, method: :delete, class: "btn btn-secondary", form: { data: { turbo_confirm: "Disconnect from Xero? Imported data stays." } } %>
  </div>
<% end %>
