<header class="page-header">
  <h1>Settings</h1>
</header>

<div class="settings-stack">
  <section class="panel">
    <div class="panel-head"><h2 class="panel-title">Organisation</h2><span class="meta">everyone</span></div>
    <div class="panel-body">
      <%= form_with model: Current.organization, url: organization_settings_path, method: :patch, class: "app-form settings-row" do |f| %>
        <div class="settings-row-label"><%= f.label :name, "Entity name" %></div>
        <div class="settings-row-main">
          <%= f.text_field :name, required: true, style: "max-width:420px;" %>
          <p class="settings-row-help">Appears in the sidebar as "<%= possessive(Current.organization.name) %> Books", on invoices and in email.</p>
        </div>
        <div class="settings-row-action"><%= f.submit "Save name", class: "btn btn-primary" %></div>
      <% end %>
      <div class="settings-row">
        <div class="settings-row-label">People</div>
        <div class="settings-row-main">
          <% if Auth.launchpad? %>
            Who can sign in is managed in Launchpad.
          <% else %>
            <%= pluralize(Current.organization.users.local.count, "person") %> can sign in.
          <% end %>
        </div>
        <div class="settings-row-action"><%= Auth.launchpad? ? link_to("Open Launchpad", Auth.launchpad_base_url, class: "btn btn-secondary") : link_to("Manage", people_path, class: "btn btn-secondary") %></div>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2 class="panel-title">Dashboard accounts</h2><span class="meta">chart of accounts</span></div>
    <div class="panel-body">
      <%= form_with model: @settings, url: settings_path, method: :patch, class: "app-form" do |f| %>
        <% if @settings.errors.any? %>
          <div class="form-errors"><ul><% @settings.errors.full_messages.each { |m| %><li><%= m %></li><% } %></ul></div>
        <% end %>
        <p class="settings-row-help" style="margin:0 0 14px;">The accounts behind the three dashboard cards. Bank accounts are managed under <%= link_to "Banking", bank_accounts_path %>.</p>
        <div class="settings-row">
          <div class="settings-row-label"><%= f.label :bank_account_id, "Operating bank" %></div>
          <div class="settings-row-main"><%= f.collection_select :bank_account_id, @bank_accounts, :id, :display_name, include_blank: "—" %></div>
        </div>
        <div class="settings-row">
          <div class="settings-row-label"><%= f.label :receivable_account_id, "Receivable" %></div>
          <div class="settings-row-main"><%= f.collection_select :receivable_account_id, @asset_accounts, :id, ->(a) { "#{a.code.present? ? "#{a.code} — " : ""}#{a.name}" }, include_blank: "—" %></div>
        </div>
        <div class="settings-row">
          <div class="settings-row-label"><%= f.label :payable_account_id, "Payable" %></div>
          <div class="settings-row-main"><%= f.collection_select :payable_account_id, @liability_accounts, :id, ->(a) { "#{a.code.present? ? "#{a.code} — " : ""}#{a.name}" }, include_blank: "—" %></div>
        </div>
        <div class="settings-actions"><%= f.submit "Save accounts", class: "btn btn-primary" %></div>
      <% end %>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2 class="panel-title">Connections</h2><span class="meta">xero · bank feed</span></div>
    <div class="panel-body">
      <div class="settings-row">
        <div class="settings-row-label">Xero</div>
        <div class="settings-row-main">
          <% if (xc = Current.organization.xero_connection) %>
            Connected to <strong><%= xc.tenant_name %></strong><%= xc.last_import_at ? ", last imported #{time_ago_in_words(xc.last_import_at)} ago" : ", not imported yet" %>.
          <% else %>
            Not connected. <span class="settings-row-help">Pulls the whole history, tracking included, from Xero's API.</span>
          <% end %>
        </div>
        <div class="settings-row-action"><%= link_to (xc ? "Manage" : "Connect"), xero_connection_path, class: "btn btn-secondary" %></div>
      </div>
      <div class="settings-row">
        <div class="settings-row-label">Bank feed</div>
        <div class="settings-row-main">
          <% if (feed = Current.organization.bank_feed) %>
            Connected via SimpleFIN<%= feed.last_synced_at ? ", last synced #{time_ago_in_words(feed.last_synced_at)} ago" : ", not synced yet" %>.
          <% else %>
            Not connected. <span class="settings-row-help">Pulls bank and card lines in every night.</span>
          <% end %>
        </div>
        <div class="settings-row-action"><%= link_to (feed ? "Manage" : "Connect"), bank_feed_path, class: "btn btn-secondary" %></div>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2 class="panel-title">Books</h2><span class="meta">tracking · tax</span></div>
    <div class="panel-body">
      <div class="settings-row">
        <div class="settings-row-label">Tracking categories</div>
        <div class="settings-row-main">
          <% cats = Current.organization.tracking_categories.ordered.includes(:options) %>
          <% if cats.any? %>
            <%= cats.map { |c| "#{c.name} (#{c.options.size})" }.to_sentence %>
          <% else %>
            None yet. <span class="settings-row-help">Slice the books by event year, business line, or anything else.</span>
          <% end %>
        </div>
        <div class="settings-row-action"><%= link_to "Manage", tracking_categories_path, class: "btn btn-secondary" %></div>
      </div>
      <div class="settings-row">
        <div class="settings-row-label">Tax rates</div>
        <div class="settings-row-main"><%= pluralize(Current.organization.tax_rates.count, "rate") %> defined.</div>
        <div class="settings-row-action"><%= link_to "Manage", tax_rates_path, class: "btn btn-secondary" %></div>
      </div>
      <%= form_with model: @settings, url: invoicing_settings_path, method: :patch, class: "app-form settings-row" do |f| %>
        <div class="settings-row-label"><%= f.label :invoice_prefix, "Invoice numbering" %></div>
        <div class="settings-row-main">
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <%= f.text_field :invoice_prefix, style: "max-width:120px;", placeholder: "none", "aria-label": "Prefix" %>
            <%= f.number_field :invoice_next_number, value: @settings.invoice_next_number, min: 1, step: 1, style: "max-width:140px;", placeholder: "next", "aria-label": "Next number" %>
          </div>
          <p class="settings-row-help">Next invoice: <strong><%= @settings.next_invoice_number %></strong>. Prefix can be blank. Leave the number empty to follow the highest invoice with this prefix.</p>
        </div>
        <div class="settings-row-action"><%= f.submit "Save numbering", class: "btn btn-primary" %></div>
      <% end %>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><h2 class="panel-title">Imports and data</h2><span class="meta">fallbacks</span></div>
    <div class="panel-body">
      <div class="settings-row">
        <div class="settings-row-label">Bank statement</div>
        <div class="settings-row-main">CSV, OFX or QFX, for a window the feed missed or an account it can't see.</div>
        <div class="settings-row-action"><%= link_to "Upload", new_imports_bank_path, class: "btn btn-secondary" %></div>
      </div>
      <div class="settings-row">
        <div class="settings-row-label">Xero exports by file</div>
        <div class="settings-row-main">Chart of accounts, contacts, invoices, bills, journal report, tax rates.</div>
        <div class="settings-row-action"><%= link_to "Open", imports_path, class: "btn btn-secondary" %></div>
      </div>
    </div>
  </section>

  <%= render "settings/appearance" %>
</div>
