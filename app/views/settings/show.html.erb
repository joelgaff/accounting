<header class="page-header">
  <h1>Settings</h1>
</header>

<section style="margin:0 0 32px;">
  <h2 style="font-size:15px;font-weight:600;margin:0 0 8px;">Whose books</h2>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">The entity's name, as it appears in the sidebar, on invoices and in email.</p>
  <%= form_with model: Current.organization, url: organization_settings_path, method: :patch, class: "app-form filter-bar" do |f| %>
    <div class="field" style="margin:0;flex:1;max-width:420px;">
      <%= f.label :name, "Entity name" %>
      <%= f.text_field :name, required: true %>
    </div>
    <%= f.submit "Save name", class: "btn btn-primary" %>
  <% end %>
</section>

<%= form_with model: @settings, url: settings_path, method: :patch, class: "app-form" do |f| %>
  <% if @settings.errors.any? %>
    <div class="form-errors">
      <ul>
        <% @settings.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset style="border:0;padding:0;margin:0 0 20px">
    <legend style="font-weight:600;padding:0 0 8px;font-size:13px;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-muted);">Dashboard KPIs</legend>
    <p class="muted" style="margin:0 0 16px;font-size:13px;">Pick which accounts back each KPI card on the dashboard. Only accounts in your Chart of Accounts show up.</p>

    <div class="field">
      <%= f.label :bank_account_id, "Operating bank account" %>
      <%= f.collection_select :bank_account_id, @bank_accounts, :id, :display_name, include_blank: "—" %>
      <p class="muted" style="margin:6px 0 0;font-size:12px;">Manage these under <%= link_to "Banking", bank_accounts_path %>.</p>
    </div>

    <div class="field">
      <%= f.label :receivable_account_id, "Accounts receivable" %>
      <%= f.collection_select :receivable_account_id, @asset_accounts, :id, ->(a) { "#{a.code.present? ? "#{a.code} — " : ""}#{a.name}" }, include_blank: "—" %>
    </div>

    <div class="field">
      <%= f.label :payable_account_id, "Accounts payable" %>
      <%= f.collection_select :payable_account_id, @liability_accounts, :id, ->(a) { "#{a.code.present? ? "#{a.code} — " : ""}#{a.name}" }, include_blank: "—" %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit "Save settings", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "settings/appearance" %>

<section style="margin-top:32px;">
  <h2 style="font-size:15px;font-weight:600;margin:0 0 8px;">Tracking categories</h2>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">
    <% cats = Current.organization.tracking_categories.ordered.includes(:options) %>
    <%= cats.any? ? cats.map { |c| "#{c.name} (#{c.options.size} options)" }.to_sentence : "Slice the books by event year, business line, or anything else, one option per line." %>
  </p>
  <%= link_to "Manage tracking categories", tracking_categories_path, class: "btn btn-secondary" %>
</section>

<section style="margin-top:32px;">
  <h2 style="font-size:15px;font-weight:600;margin:0 0 8px;">Xero</h2>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">
    <% if (xc = Current.organization.xero_connection) %>
      Connected to <%= xc.tenant_name %><%= xc.last_import_at ? ", last imported #{time_ago_in_words(xc.last_import_at)} ago" : "" %>.
    <% else %>
      Pull the whole history, tracking included, straight from Xero's API.
    <% end %>
  </p>
  <%= link_to "Manage Xero connection", xero_connection_path, class: "btn btn-secondary" %>
</section>

<section style="margin-top:32px;">
  <h2 style="font-size:15px;font-weight:600;margin:0 0 8px;">Bank feed</h2>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">
    <% if Current.organization.bank_feed %>
      Connected via SimpleFIN<%= Current.organization.bank_feed.last_synced_at ? ", last synced #{time_ago_in_words(Current.organization.bank_feed.last_synced_at)} ago" : "" %>.
    <% else %>
      Pull transactions from your bank every night instead of uploading statements.
    <% end %>
  </p>
  <%= link_to "Manage bank feed", bank_feed_path, class: "btn btn-secondary" %>
</section>

<section style="margin-top:32px;">
  <h2 style="font-size:15px;font-weight:600;margin:0 0 8px;">Imports and data</h2>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">
    Fallbacks for when the Xero connection and the bank feed above don't cover something: a statement file for a
    gap in the feed, or a Xero export by file.
  </p>
  <ul class="link-list">
    <li><%= link_to "Upload a bank statement (CSV, OFX, QFX)", new_imports_bank_path %> <span class="muted">— for a window the feed missed or an account it can't see</span></li>
    <li><%= link_to "Import Xero exports by file", imports_path %> <span class="muted">— chart of accounts, contacts, invoices, bills, journal report, tax rates</span></li>
  </ul>
</section>
