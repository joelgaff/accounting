<%= form_with model: invoice, class: "app-form", style: "max-width:none;" do |f| %>
  <% if invoice.errors.any? %>
    <div class="form-errors">
      <ul>
        <% invoice.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if customers.any? %>
    <div class="field">
      <%= f.label :contact_id, "Customer" %>
      <%= f.collection_select :contact_id, customers, :id, :name, include_blank: "— pick a customer or type a name below —" %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :client_name, "Client name (used if no customer picked)" %>
    <%= f.text_field :client_name, autofocus: customers.empty? %>
  </div>

  <div class="field">
    <%= f.label :due_date, "Due date" %>
    <%= f.date_field :due_date %>
  </div>

  <div class="field">
    <%= f.label :receivable_account_id, "Receivable account (debit)" %>
    <%= f.collection_select :receivable_account_id, receivable_accounts, :id, :name, prompt: "Select an asset account" %>
  </div>

  <%# Line items — one row per service line, each with its own revenue account + optional tax. %>
  <%= render "shared/line_items_fields", form: f, accounts: revenue_accounts, tax_rates: tax_rates %>

  <div class="field">
    <%= f.label :attachments, "Attachments (PDF, images)" %>
    <%= f.file_field :attachments, multiple: true %>
  </div>

  <div class="form-actions">
    <%= f.submit "Create invoice", class: "btn btn-primary" %>
    <%= link_to "Cancel", invoices_path, class: "btn btn-secondary" %>
  </div>
<% end %>
