<%= form_with model: document, **document_form_options(document), class: "app-form app-form-wide" do |f| %>
  <%= render "documents/errors", document: document %>

  <% if customers.any? %>
    <div class="field">
      <%= f.label :contact_id, "Customer" %>
      <%= f.collection_select :contact_id, customers, :id, :name, include_blank: "— pick a customer or type a name below —" %>
    </div>
  <% end %>

  <%= f.fields_for :documentable, document.invoice do |inv| %>
    <div class="field">
      <%= inv.label :client_name, "Client name (used if no customer picked)" %>
      <%= inv.text_field :client_name, autofocus: customers.empty? %>
    </div>

    <div class="field">
      <%= f.label :date, "Issue date" %>
      <%= f.date_field :date %>
    </div>

    <div class="field">
      <%= inv.label :due_date, "Due date" %>
      <%= inv.date_field :due_date %>
    </div>

    <div class="field">
      <%= inv.label :receivable_account_id, "Receivable account (debit)" %>
      <%= inv.collection_select :receivable_account_id, receivable_accounts, :id, :name, prompt: "Select an asset account" %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :reference, "Reference (optional)" %>
    <%= f.text_field :reference %>
  </div>

  <%# Line items — one row per service line, each with its own revenue account + optional tax. %>
  <%= render "shared/line_items_fields", form: f, accounts: revenue_accounts, tax_rates: tax_rates %>

  <div class="field">
    <%= f.label :attachments, "Attachments (PDF, images)" %>
    <%= f.file_field :attachments, multiple: true %>
  </div>

  <div class="form-actions">
    <%= f.submit (document.new_record? ? "Create invoice" : "Update invoice"), class: "btn btn-primary" %>
    <%= link_to "Cancel", invoices_path, class: "btn btn-secondary" %>
  </div>
<% end %>
