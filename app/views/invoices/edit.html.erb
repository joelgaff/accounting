<header class="page-header">
  <h1>Edit <%= @document.label.downcase %></h1>
</header>

<% if @revenue_accounts.empty? %>
  <div class="notice">
    <p>You need at least one <strong>Revenue</strong> account (typically "Sales") in your Chart of Accounts before you can create an invoice.</p>
  </div>
<% else %>
  <%= render "form", document: @document, revenue_accounts: @revenue_accounts, customers: @customers, tax_rates: @tax_rates %>
<% end %>
