<header class="page-header">
  <h1>Invoices</h1>
  <div style="display:flex;gap:8px;">
    <%= link_to "Recurring", recurring_invoices_path, class: "btn btn-secondary" %>
    <%= link_to "New invoice", new_invoice_path, class: "btn btn-primary" %>
  </div>
</header>

<% if @documents.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Issued</th>
        <th>Client</th>
        <th>Due</th>
        <th>Status</th>
        <th class="num">Amount</th>
        <th class="num">Balance due</th>
      </tr>
    </thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr id="<%= dom_id(document) %>">
          <td><%= document.date.iso8601 %></td>
          <td><%= link_to document.counterparty, invoice_path(document) %></td>
          <td><%= document.invoice.due_date.iso8601 %></td>
          <td><%= status_badge(document.status) %></td>
          <td class="num"><%= money(document.total) %></td>
          <td class="num"><%= money(document.balance_due) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No invoices yet.</p>
<% end %>
