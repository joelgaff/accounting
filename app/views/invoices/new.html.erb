<header class="page-header">
  <h1>New invoice</h1>
</header>

<% if @receivable_accounts.empty? || @revenue_accounts.empty? %>
  <div class="notice">
    <p>You need to set up your Chart of Accounts before you can create an invoice.</p>
    <p>At minimum you need one <strong>Asset</strong> account (typically "Accounts Receivable") and one <strong>Revenue</strong> account (typically "Sales").</p>
  </div>
<% else %>
  <%= render "form", invoice: @invoice, receivable_accounts: @receivable_accounts, revenue_accounts: @revenue_accounts %>
<% end %>
