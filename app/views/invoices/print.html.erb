<% content_for :head do %>
  <style>
    /* An invoice is a document, not a console window — print it on paper. */
    html, body { background: #fff; color: #14181f; }
    body::before { display: none; }
    .app-shell { margin:0; border:0; border-radius:0; box-shadow:none; background:#fff; max-width:none; }
    .app-shell::before, .app-titlebar, .app-nav, .app-statusbar, .flash { display: none !important; }
    .app-body { display: block; }
    .app-main { max-width: 780px; margin: 0 auto; padding: 40px; }
    .doc { --paper-ink:#14181f; --paper-dim:#5d6672; --paper-rule:#d8dde4; color: var(--paper-ink); }
    .doc a { color: var(--paper-ink); text-decoration: none; }
    .invoice-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:32px; }
    .invoice-header h1 { margin:0; font-size:30px; letter-spacing:0.06em; text-transform:uppercase; }
    .invoice-meta { text-align:right; font-size:12px; color:var(--paper-dim); }
    .invoice-meta strong { color:var(--paper-ink); font-size:13px; }
    .invoice-bill { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:32px; }
    .invoice-bill h3 { font-size:10px; text-transform:uppercase; letter-spacing:0.16em; margin:0 0 6px; color:var(--paper-dim); }
    table.invoice-lines { width:100%; border-collapse:collapse; margin-bottom:20px; font-variant-numeric:tabular-nums; }
    table.invoice-lines th { text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:0.14em; color:var(--paper-dim); border-bottom:2px solid var(--paper-ink); padding:8px 4px; }
    table.invoice-lines td { padding:11px 4px; border-bottom:1px solid var(--paper-rule); }
    table.invoice-lines .num { text-align:right; }
    .totals { margin-left:auto; width:280px; }
    .totals tr td { padding:6px 4px; }
    .totals .total { font-weight:700; font-size:15px; border-top:2px solid var(--paper-ink); }
    .print-hide .btn { border-color:#c9d0d9; background:#f2f4f7; color:#14181f; }
    .print-hide .btn:hover { background:#e6eaef; color:#14181f; }
    .print-hide .btn-primary { border-color:#14181f; background:#14181f; color:#fff; }
    .print-hide .btn-primary:hover { background:#2b323c; color:#fff; }
    @media print { .app-main { padding: 0; } .print-hide { display: none !important; } }
  </style>
<% end %>

<% invoice = @document.invoice %>
<div class="print-hide" style="margin-bottom:16px;">
  <button onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button>
  <%= link_to "Email to customer", email_invoice_path(@document), class: "btn btn-secondary" %>
  <%= link_to "← Back", invoice_path(@document), class: "btn btn-secondary" %>
</div>

<div class="doc">
<div class="invoice-header">
  <div>
    <h1>Invoice</h1>
    <p style="margin:8px 0 0;color:var(--text-muted);">#<%= @document.id %></p>
  </div>
  <div class="invoice-meta">
    <strong><%= @document.organization.name %></strong><br>
    Issued <%= @document.date.strftime("%b %-d, %Y") %><br>
    Due <%= invoice.due_date.strftime("%b %-d, %Y") %>
  </div>
</div>

<div class="invoice-bill">
  <div>
    <h3>Billed to</h3>
    <div><%= @document.counterparty %></div>
    <% if @document.contact %>
      <% c = @document.contact %>
      <div style="font-size:13px;color:var(--text-muted);margin-top:4px;">
        <%= c.email %><br>
        <%= [c.address, [c.city, c.region, c.postal_code].compact_blank.join(", "), c.country].compact_blank.join("\n").then { |a| simple_format a, {}, wrapper_tag: "span" } if [c.address, c.city, c.country].any?(&:present?) %>
      </div>
    <% end %>
  </div>
  <div>
    <h3>Balance due</h3>
    <div style="font-size:24px;font-weight:600;">$<%= number_with_precision(@document.balance_due, precision: 2, delimiter: ",") %></div>
    <div style="font-size:12px;color:var(--text-muted);">of $<%= number_with_precision(@document.total, precision: 2, delimiter: ",") %></div>
  </div>
</div>

<table class="invoice-lines">
  <thead><tr><th>Description</th><th class="num">Qty</th><th class="num">Unit</th><th class="num">Amount</th></tr></thead>
  <tbody>
    <% @document.line_items.each do |li| %>
      <tr>
        <td><%= li.description.presence || li.account.name %></td>
        <td class="num"><%= li.quantity.to_d.frac.zero? ? li.quantity.to_i : li.quantity %></td>
        <td class="num">$<%= number_with_precision(li.unit_amount, precision: 2, delimiter: ",") %></td>
        <td class="num">$<%= number_with_precision(li.amount, precision: 2, delimiter: ",") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<table class="totals">
  <tr>
    <td>Subtotal</td>
    <td class="num">$<%= number_with_precision(@document.subtotal, precision: 2, delimiter: ",") %></td>
  </tr>
  <% @document.line_ledger_legs[:taxes].each do |tax, amt| %>
    <tr>
      <td><%= tax.name %></td>
      <td class="num">$<%= number_with_precision(amt, precision: 2, delimiter: ",") %></td>
    </tr>
  <% end %>
  <tr class="total">
    <td>Total</td>
    <td class="num">$<%= number_with_precision(@document.total, precision: 2, delimiter: ",") %></td>
  </tr>
  <% if @document.paid_amount.positive? %>
    <tr>
      <td>Paid</td>
      <td class="num">−$<%= number_with_precision(@document.paid_amount, precision: 2, delimiter: ",") %></td>
    </tr>
    <tr class="total">
      <td>Balance due</td>
      <td class="num">$<%= number_with_precision(@document.balance_due, precision: 2, delimiter: ",") %></td>
    </tr>
  <% end %>
</table>
</div>
