<header class="page-header">
  <h1>Edit transfer #<%= @document.id %></h1>
</header>

<% if @bank_accounts.size < 2 %>
  <div class="notice">
    <p>A transfer needs two bank accounts. <%= link_to "Add one under Banking", new_bank_account_path %>.</p>
  </div>
<% else %>
  <%= render "form", document: @document, bank_accounts: @bank_accounts %>
<% end %>
