<header class="page-header">
  <h1>Transfers</h1>
  <%= link_to "New transfer", new_transfer_path, class: "btn btn-primary" %>
</header>

<%= render "documents/status_filter", statuses: [] %>

<% if @documents.any? %>
  <table class="data-table cards">
    <thead>
      <tr><th>Date</th><th>From</th><th>To</th><th>Reference</th><th class="num">Amount</th></tr>
    </thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr id="<%= dom_id(document) %>" class="<%= 'muted' if document.voided? %>">
          <td data-cell="secondary"><%= link_to document.date.iso8601, transfer_path(document) %></td>
          <td data-cell="primary"><%= document.transfer.from_bank_account.name %></td>
          <td data-cell="secondary" data-label="→"><%= document.transfer.to_bank_account.name %></td>
          <td class="muted"><%= document.reference %></td>
          <td class="num" data-cell="amount"><%= money(document.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
<% else %>
  <p class="empty-state">No transfers yet.</p>
<% end %>
