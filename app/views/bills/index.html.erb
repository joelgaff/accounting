<header class="page-header">
  <h1>Bills</h1>
  <%= link_to "New bill", new_bill_path, class: "btn btn-primary page-primary" %>
</header>

<%= render "documents/status_filter", statuses: %w[draft unpaid open partial paid billable] %>

<% if @documents.any? %>
  <table class="data-table cards">
    <thead>
      <tr>
        <th>Number</th>
        <th>Date</th>
        <th>Vendor</th>
        <th>Category</th>
        <th>Payable to</th>
        <th>Status</th>
        <th class="num">Amount</th>
        <th class="num">Balance due</th>
      </tr>
    </thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr id="<%= dom_id(document) %>" class="<%= 'muted' if document.voided? %>">
          <td data-cell="secondary"><%= link_to(document.bill.number.presence || "—", bill_path(document)) %></td>
          <td data-cell="secondary"><%= document.date.iso8601 %></td>
          <td data-cell="primary"><%= link_to document.counterparty, bill_path(document) %></td>
          <td><%= document.bill.category_display %></td>
          <td><%= document.bill.payable_account.name %></td>
          <td data-cell="status"><%= status_badge(document.status) %></td>
          <td class="num" data-cell="amount"><%= money(document.total) %></td>
          <td class="num"><%= money(document.balance_due) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
<% else %>
  <p class="empty-state"><%= @status.present? ? "Nothing matches this filter." : "No bills yet." %></p>
<% end %>
