<%= form_with model: document, **document_form_options(document), class: "app-form app-form-wide" do |f| %>
  <%= render "documents/errors", document: document %>
  <%= f.hidden_field :copied_from_id if document.copied_from_id.present? %>

  <% if vendors.any? %>
    <div class="field">
      <%= f.label :contact_id, "Vendor" %>
      <%= f.collection_select :contact_id, vendors, :id, :name, include_blank: "— pick a vendor or type a name below —" %>
    </div>
  <% end %>

  <%= f.fields_for :documentable, document.bill do |bill| %>
    <div class="field">
      <%= bill.label :vendor, "Vendor name (used if no vendor picked)" %>
      <%= bill.text_field :vendor, autofocus: vendors.empty? %>
    </div>

    <div class="field">
      <%= bill.label :number, "Vendor's invoice number (optional)" %>
      <%= bill.text_field :number, style: "max-width:200px;" %>
    </div>

    <div class="field">
      <%= f.label :date, "Bill date" %>
      <%= f.date_field :date %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :billable_to_id, "Bill to" %>
    <%= f.collection_select :billable_to_id, customers, :id, :name, include_blank: "Not billable" %>
    <span class="field-help">A customer this cost will be picked up on an invoice for.</span>
  </div>

  <div class="field">
    <%= f.label :reference, "Reference (optional)" %>
    <%= f.text_field :reference %>
  </div>

  <%= render "shared/line_items_fields", form: f, accounts: expense_accounts, tax_rates: tax_rates %>

  <div class="field">
    <%= f.label :memo %>
    <%= f.text_area :memo, rows: 3 %>
  </div>

  <div class="field">
    <%= f.label :attachments, "Attachments (PDF, images)" %>
    <%= f.file_field :attachments, multiple: true %>
  </div>

  <div class="form-actions">
    <% if document.draft? %>
      <%= f.submit "Save draft", class: "btn btn-secondary" %>
      <%= f.submit "Approve", name: "approve", class: "btn btn-primary" %>
    <% else %>
      <%= f.submit "Update bill", class: "btn btn-primary" %>
    <% end %>
    <%= link_to "Cancel", bills_path, class: "btn btn-secondary" %>
  </div>
<% end %>
