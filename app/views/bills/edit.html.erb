<header class="page-header">
  <h1>Edit <%= @document.label.downcase %></h1>
</header>

<% if @expense_accounts.empty? %>
  <div class="notice">
    <p>You need at least one <strong>Expense</strong> category in your Chart of Accounts before you can record a bill.</p>
  </div>
<% else %>
  <%= render "form", document: @document, expense_accounts: @expense_accounts, vendors: @vendors, customers: @customers, tax_rates: @tax_rates %>
<% end %>
