<%= form_with model: rule, class: "app-form" do |f| %>
  <% if rule.errors.any? %>
    <div class="form-errors"><ul><% rule.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Cloudflare hosting" %>
  </div>

  <fieldset class="line-items" style="margin:0 0 16px;" data-controller="nested-rows" data-nested-rows-index-value="<%= rule.conditions.size %>">
    <legend>When a line…</legend>
    <div class="field">
      <div class="theme-choice">
        <% [ [ true, "meets every condition" ], [ false, "meets any condition" ] ].each do |value, text| %>
          <label class="theme-option">
            <%= f.radio_button :match_all, value, class: "theme-radio" %>
            <span class="theme-mark" aria-hidden="true"></span><%= text %>
          </label>
        <% end %>
      </div>
    </div>
    <div class="sheet-scroll">
      <table class="data-table sheet">
        <thead><tr><th style="width:180px;">Field</th><th style="width:140px;">Test</th><th>Value</th><th style="width:120px;">and</th><th style="width:40px;"></th></tr></thead>
        <tbody data-nested-rows-target="rows">
          <%= f.fields_for :conditions do |c| %>
            <%= render "bank_rules/condition_fields", c: c %>
          <% end %>
        </tbody>
      </table>
    </div>
    <template data-nested-rows-target="template">
      <%= f.fields_for :conditions, BankRuleCondition.new, child_index: "NEW_RECORD" do |c| %>
        <%= render "bank_rules/condition_fields", c: c %>
      <% end %>
    </template>
    <button type="button" class="btn btn-secondary" data-action="nested-rows#add">+ Add condition</button>
    <p class="settings-row-help" style="margin:8px 0 0;">Amount tests compare the size of the amount; direction is set below. Text tests ignore case.</p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px;">
      <div class="field">
        <%= f.label :amount_sign, "Direction" %>
        <%= f.select :amount_sign, [ [ "either way", "any" ], [ "money in", "in" ], [ "money out", "out" ] ] %>
      </div>
      <div class="field">
        <%= f.label :bank_account_id, "Only this account" %>
        <%= f.collection_select :bank_account_id, bank_accounts, :id, :display_name, include_blank: "Any account" %>
      </div>
    </div>
  </fieldset>

  <fieldset style="border:0;padding:0;margin:0 0 16px;">
    <legend style="font-weight:600;font-size:13px;margin-bottom:8px;">…then create</legend>
    <div class="field">
      <%= f.label :action_kind, "Kind" %>
      <%= f.select :action_kind, BankRule::ACTIONS.map { |k| [ k, k ] } %>
    </div>
    <div class="field">
      <%= f.label :account_id, "Account (expense or deposit)" %>
      <%= f.collection_select :account_id, accounts, :id, ->(a) { "#{a.code.present? ? "#{a.code} — " : ""}#{a.name} (#{a.type.demodulize})" }, include_blank: "—" %>
    </div>
    <div class="field">
      <%= f.label :transfer_bank_account_id, "Other account (transfer)" %>
      <%= f.collection_select :transfer_bank_account_id, bank_accounts, :id, :display_name, include_blank: "—" %>
    </div>
    <div class="field">
      <%= f.label :contact_id, "Contact (optional)" %>
      <%= f.collection_select :contact_id, contacts, :id, :name, include_blank: "—" %>
    </div>
    <% if tracking_categories.any? %>
      <div class="field">
        <label>Tracking (optional)</label>
        <div style="display:flex;gap:8px;"><%= tracking_selects("bank_rule", rule) %></div>
      </div>
    <% end %>
    <% if tax_rates.any? %>
      <div class="field">
        <%= f.label :tax_rate_id, "Tax included (optional)" %>
        <%= f.collection_select :tax_rate_id, tax_rates, :id, :name, include_blank: "None" %>
      </div>
    <% end %>
  </fieldset>

  <div class="field">
    <%= f.check_box :auto_apply %>
    <%= f.label :auto_apply, "Auto-apply on import (otherwise the rule only suggests)", style: "display:inline;" %>
  </div>
  <div class="field">
    <%= f.check_box :active %>
    <%= f.label :active, "Active", style: "display:inline;" %>
  </div>

  <div class="form-actions">
    <%= f.submit (rule.new_record? ? "Add rule" : "Save rule"), class: "btn btn-primary" %>
    <%= link_to "Cancel", bank_rules_path, class: "btn btn-secondary" %>
  </div>
<% end %>
