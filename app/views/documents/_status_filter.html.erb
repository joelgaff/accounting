<%# ?status= filter for an index, as a row of chips. `statuses` are the type's own; voided and all are always offered. %>
<% choices = [ [ "Active", "" ] ] + statuses.map { |s| [ s.titleize, s ] } + [ [ "Voided", "voided" ], [ "All", "all" ] ] %>
<nav class="chips" aria-label="Show">
  <% choices.each do |label, value| %>
    <%= chip_link label, url_for(only_path: true, status: value.presence), active: @status.to_s == value %>
  <% end %>
</nav>
