<%# Payments against a settleable document, plus the button to record one. %>
<section style="margin-top:32px;">
  <h2 style="font-size:15px;font-weight:600;margin:0 0 12px;">Payments</h2>
  <% if document.payments.any? %>
    <table class="data-table">
      <thead><tr><th>Date</th><th>Bank</th><th>Reference</th><th class="num">Amount</th></tr></thead>
      <tbody>
        <% document.payments.order(paid_on: :desc).each do |p| %>
          <tr id="<%= dom_id(p) %>">
            <td><%= p.paid_on.iso8601 %></td>
            <td><%= p.bank_account.name %></td>
            <td><%= p.reference %></td>
            <td class="num"><%= money(p.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">No payments recorded.</p>
  <% end %>
</section>
