<%# Who a cost is billable to, and whether it has been invoiced yet. %>
<% if document.billable_to %>
  <p class="billable">
    Billable to <strong><%= document.billable_to.name %></strong> ·
    <% if (invoice = document.billed_on) %>
      Billed on <%= link_to invoice.label, invoice_path(invoice) %><%= " (draft)" if invoice.draft? %>
    <% else %>
      not yet invoiced ·
      <%= link_to "New invoice for #{document.billable_to.name}", new_invoice_path(contact_id: document.billable_to.id) %>
    <% end %>
  </p>
<% end %>
