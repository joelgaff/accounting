<%# Badge plus the actions a document offers. Replaced over turbo_stream after a void. %>
<%= tag.div id: dom_id(document, :status), style: "display:flex;gap:8px;align-items:center;flex-wrap:wrap;" do %>
  <%= status_badge(document.status) %>
  <% if document.invoice? %>
    <%= link_to "Print / PDF", print_invoice_path(document), class: "btn btn-secondary" %>
    <%= link_to "Email", email_invoice_path(document), class: "btn btn-secondary" unless document.draft? %>
  <% end %>
  <% if document.draft? %>
    <%= button_to "Approve", approve_document_path_for(document), class: "btn btn-primary",
          form: { style: "display:inline", data: { turbo_confirm: "Approve #{document.label}? It posts to the ledger and starts counting." } } %>
  <% end %>
  <% unless document.voided? %>
    <%= link_to "Edit", edit_document_path_for(document), class: "btn btn-secondary" %>
    <%= button_to "Void", void_document_path_for(document), class: "btn btn-secondary",
          form: { style: "display:inline", data: { turbo_confirm: void_confirm_message(document) } } %>
    <% if document.settleable? && document.approved? && !document.paid? %>
      <%= link_to "Record payment", new_document_payment_path(document), class: "btn btn-primary" %>
    <% end %>
  <% end %>
  <% if document.deletable? %>
    <%= button_to "Delete", delete_document_path_for(document), method: :delete, class: "btn btn-secondary btn-danger",
          form: { style: "display:inline", data: { turbo_confirm: "Delete #{document.label} for good? Its lines, postings, history and attachments go with it. There is no undo." } } %>
  <% end %>
<% end %>
