<% if document.attachments.any? %>
  <section style="margin-top:32px;">
    <h2 style="font-size:15px;font-weight:600;margin:0 0 12px;"><%= local_assigns.fetch(:title, "Attachments") %></h2>
    <ul>
      <% document.attachments.each do |a| %>
        <li><%= link_to a.filename, rails_blob_path(a, disposition: "attachment") %> — <span class="muted"><%= number_to_human_size a.byte_size %></span></li>
      <% end %>
    </ul>
  </section>
<% end %>
