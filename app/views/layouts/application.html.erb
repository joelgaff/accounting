<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Accounting" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Accounting">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell">
      <% if logged_in? %>
        <nav class="app-nav">
          <div class="brand">Ledger</div>
          <div class="nav-links">
            <%= link_to "Dashboard", root_path,        class: ("active" if current_page?(root_path)) %>
            <%= link_to "Contacts",  contacts_path,    class: ("active" if %w[contacts contact_imports].include?(controller_name)) %>
            <%= link_to "Invoices",  invoices_path,    class: ("active" if controller_name == "invoices") %>
            <%= link_to "Expenses",  expenses_path,    class: ("active" if controller_name == "expenses") %>
            <%= link_to "Journal",   journal_entries_path, class: ("active" if controller_name == "journal_entries") %>
            <%= link_to "Accounts",  accounts_path,    class: ("active" if %w[accounts chart_of_accounts_imports].include?(controller_name)) %>
            <%= link_to "Reports",   reports_path,     class: ("active" if controller_name == "reports") %>
            <%= link_to "Reconcile", bank_transactions_path, class: ("active" if controller_name == "bank_transactions") %>
            <%= link_to "Import",    imports_path,     class: ("active" if controller_path.start_with?("imports")) %>
          </div>
          <div class="nav-user">
            <%= link_to "Tax", tax_rates_path, class: ("active" if controller_name == "tax_rates"), style: "padding:8px 12px;color:var(--text);border-radius:var(--radius-sm);" %>
            <%= link_to "Settings", settings_path, class: ("active" if controller_name == "settings"), style: "padding:8px 12px;color:var(--text);border-radius:var(--radius-sm);" %>
            <span><%= current_user.email %></span>
            <%= button_to "Sign out", session_path, method: :delete, form: { style: "display:inline" } %>
          </div>
        </nav>
      <% end %>

      <main class="<%= logged_in? ? "app-main" : "" %>">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type == "notice" ? "notice" : "alert" %>"><%= message %></div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
