<!DOCTYPE html>
<% theme = Current.user&.theme.presence || "dark" %>
<html data-theme="<%= theme %>">
  <head>
    <title><%= content_for(:title) || app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= app_name %>">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="<%= theme == "light" ? "#eef2f7" : "#060a12" %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# After the app stylesheet so page-level overrides (the invoice print sheet) win. %>
    <%= yield :head %>
  </head>

  <body class="<%= yield(:body_class) %>">
    <% if logged_in? %>
      <div class="app-shell">
        <header class="app-titlebar">
          <div class="tb-brand">
            <span class="tb-mark"><%= render "shared/logo_mark", size: 18 %></span><span class="tb-name"><%= app_name %></span>
          </div>
          <div class="tb-tagline"></div>
          <div class="tb-session">
            <span><%= current_user.email %></span>
            <% if Auth.launchpad? %>
              <%= button_to "Sign out", "#{Auth.launchpad_base_url}/session", method: :delete, form: { style: "display:inline" } %>
            <% else %>
              <%= button_to "Sign out", session_path, method: :delete, form: { style: "display:inline" } %>
            <% end %>
          </div>
        </header>

        <div class="app-body">
          <nav class="app-nav" aria-label="Sections">
            <%= render "layouts/nav_links" %>

            <div class="nav-footer">
              <span class="mark"><%= render "shared/logo_mark", size: 14 %></span>
              <span>
                <strong><%= app_name %></strong>
                <%= possessive(Current.organization.name) %> Books
              </span>
            </div>
          </nav>

          <main class="app-main">
            <% flash.each do |type, message| %>
              <div class="flash flash-<%= type == "notice" ? "notice" : "alert" %>"><%= message %></div>
            <% end %>

            <%= yield %>
          </main>
        </div>

        <footer class="app-statusbar">
          <span><span class="live">●</span> <%= Current.organization.name %> — books as at <%= Date.current.strftime("%b %-d, %Y") %></span>
          <span><%= app_name %></span>
        </footer>

        <%# Phone only: the bottom tab bar and the More sheet behind it. %>
        <div class="app-tabs-wrap" data-controller="sheet" data-action="keydown@window->sheet#keydown">
          <div class="sheet-dimmer" data-sheet-target="dimmer" data-action="click->sheet#close" hidden></div>
          <div class="sheet-panel" data-sheet-target="panel" hidden>
            <div class="sheet-handle" aria-hidden="true"></div>
            <%= render "layouts/nav_links" %>
            <div class="sheet-session">
              <span><%= current_user.email %></span>
              <% if Auth.launchpad? %>
                <%= button_to "Sign out", "#{Auth.launchpad_base_url}/session", method: :delete, form: { style: "display:inline" } %>
              <% else %>
                <%= button_to "Sign out", session_path, method: :delete, form: { style: "display:inline" } %>
              <% end %>
            </div>
          </div>
          <nav class="app-tabs" aria-label="Main">
            <%= tab_item "Home",      root_path,              icon: :dashboard %>
            <%= tab_item "Invoices",  invoices_path,          icon: :invoices %>
            <%= tab_item "Expenses",  expenses_path,          icon: :expenses %>
            <%= tab_item "Reconcile", bank_transactions_path, icon: :reconcile %>
            <button type="button" class="<%= 'active' if more_tab_active? %>" aria-current="<%= 'page' if more_tab_active? %>" aria-expanded="false"
                    data-sheet-target="trigger" data-action="sheet#toggle"><%= nav_icon(:more) %><span>More</span></button>
          </nav>
        </div>
      </div>
    <% else %>
      <div class="guest-shell">
        <main>
          <% flash.each do |type, message| %>
            <div class="flash flash-<%= type == "notice" ? "notice" : "alert" %>"><%= message %></div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    <% end %>
  </body>
</html>
