<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Accounting" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Accounting">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell">
      <% if logged_in? %>
        <nav class="app-nav">
          <div class="brand">Ledger</div>
          <div class="nav-links">
            <%= link_to "Dashboard", root_path,        class: ("active" if current_page?(root_path)) %>
            <%= link_to "Invoices",  invoices_path,    class: ("active" if controller_name == "invoices") %>
            <%= link_to "Expenses",  expenses_path,    class: ("active" if controller_name == "expenses") %>
            <%= link_to "Accounts",  accounts_path,    class: ("active" if %w[accounts chart_of_accounts_imports].include?(controller_name)) %>
            <%= link_to "Import",    new_import_path,  class: ("active" if controller_name == "imports") %>
          </div>
          <div class="nav-user">
            <span><%= current_user.email %></span>
            <%= button_to "Sign out", session_path, method: :delete, form: { style: "display:inline" } %>
          </div>
        </nav>
      <% end %>

      <main class="<%= logged_in? ? "app-main" : "" %>">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type == "notice" ? "notice" : "alert" %>"><%= message %></div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
