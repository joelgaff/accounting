<header class="page-header">
  <h1>Expenses</h1>
  <%= link_to "New expense", new_expense_path, class: "btn btn-primary page-primary" %>
</header>

<%= render "documents/status_filter", statuses: %w[billable] %>

<% if @documents.any? %>
  <table class="data-table cards">
    <thead>
      <tr>
        <th>Date</th>
        <th>Vendor</th>
        <th>Category</th>
        <th>Memo</th>
        <th>Paid from</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr id="<%= dom_id(document) %>" class="<%= 'muted' if document.voided? %>">
          <td data-cell="secondary"><%= document.date.iso8601 %></td>
          <td data-cell="primary"><%= link_to document.counterparty, expense_path(document) %></td>
          <td data-cell="secondary"><%= document.expense.category_display %></td>
          <td data-cell="secondary" class="muted"><%= document.why %></td>
          <td><%= document.expense.bank_account.name %></td>
          <td class="num" data-cell="amount"><%= money(document.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
<% else %>
  <p class="empty-state">No expenses yet.</p>
<% end %>
