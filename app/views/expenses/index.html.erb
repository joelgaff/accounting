<header class="page-header">
  <h1>Expenses</h1>
  <%= link_to "New expense", new_expense_path, class: "btn btn-primary" %>
</header>

<% if @expenses.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Incurred</th>
        <th>Vendor</th>
        <th>Category</th>
        <th>Paid from</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% @expenses.each do |expense| %>
        <tr>
          <td><%= expense.incurred_on.iso8601 %></td>
          <td><%= expense.vendor %></td>
          <td><%= expense.expense_account.name %></td>
          <td><%= expense.paid_from_account.name %></td>
          <td class="num">$<%= number_with_precision(expense.amount, precision: 2, delimiter: ",") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No expenses yet.</p>
<% end %>
