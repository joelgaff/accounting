<header class="page-header">
  <h1>Expenses</h1>
  <%= link_to "New expense", new_expense_path, class: "btn btn-primary" %>
</header>

<% if @documents.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Vendor</th>
        <th>Category</th>
        <th>Paid from</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr id="<%= dom_id(document) %>">
          <td><%= document.date.iso8601 %></td>
          <td><%= link_to document.counterparty, expense_path(document) %></td>
          <td><%= document.expense.category_display %></td>
          <td><%= document.expense.bank_account.name %></td>
          <td class="num"><%= money(document.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No expenses yet.</p>
<% end %>
