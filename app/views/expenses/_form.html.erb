<%= form_with model: expense, class: "app-form", style: "max-width:none;" do |f| %>
  <% if expense.errors.any? %>
    <div class="form-errors">
      <ul>
        <% expense.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if vendors.any? %>
    <div class="field">
      <%= f.label :contact_id, "Vendor" %>
      <%= f.collection_select :contact_id, vendors, :id, :name, include_blank: "— pick a vendor or type a name below —" %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :vendor, "Vendor name (used if no vendor picked)" %>
    <%= f.text_field :vendor, autofocus: vendors.empty? %>
  </div>

  <div class="field">
    <%= f.label :incurred_on, "Date incurred" %>
    <%= f.date_field :incurred_on %>
  </div>

  <div class="field">
    <%= f.label :paid_from_account_id, "Paid from (credit)" %>
    <%= f.collection_select :paid_from_account_id, paid_from_accounts, :id, ->(a) { "#{a.name} (#{a.type.demodulize})" }, prompt: "Select an asset or liability account" %>
  </div>

  <%# Line items — one row per expense line, each with its own category + optional tax. %>
  <%= render "shared/line_items_fields", form: f, accounts: expense_accounts, tax_rates: tax_rates %>

  <div class="field">
    <%= f.label :memo %>
    <%= f.text_area :memo, rows: 3 %>
  </div>

  <div class="field">
    <%= f.label :receipts, "Receipts (PDF, images)" %>
    <%= f.file_field :receipts, multiple: true %>
  </div>

  <div class="form-actions">
    <%= f.submit "Record expense", class: "btn btn-primary" %>
    <%= link_to "Cancel", expenses_path, class: "btn btn-secondary" %>
  </div>
<% end %>
