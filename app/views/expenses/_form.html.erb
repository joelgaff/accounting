<%= form_with model: expense, class: "app-form" do |f| %>
  <% if expense.errors.any? %>
    <div class="form-errors">
      <ul>
        <% expense.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if vendors.any? %>
    <div class="field">
      <%= f.label :contact_id, "Vendor" %>
      <%= f.collection_select :contact_id, vendors, :id, :name, include_blank: "— pick a vendor or type a name below —" %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :vendor, "Vendor name (used if no vendor picked)" %>
    <%= f.text_field :vendor, autofocus: vendors.empty? %>
  </div>

  <div class="field">
    <%= f.label :amount, "Amount (subtotal, before tax)" %>
    <%= f.number_field :amount, step: 0.01, min: 0 %>
  </div>

  <% if tax_rates.any? %>
    <div class="field">
      <%= f.label :tax_rate_id, "Tax rate" %>
      <%= f.collection_select :tax_rate_id, tax_rates, :id, ->(t) { "#{t.name} (#{number_to_percentage(t.rate * 100, precision: 2)})" }, include_blank: "— no tax —" %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :incurred_on, "Date incurred" %>
    <%= f.date_field :incurred_on %>
  </div>

  <div class="field">
    <%= f.label :expense_account_id, "Category (debit)" %>
    <%= f.collection_select :expense_account_id, expense_accounts, :id, :name, prompt: "Select an expense category" %>
  </div>

  <div class="field">
    <%= f.label :paid_from_account_id, "Paid from (credit)" %>
    <%= f.collection_select :paid_from_account_id, paid_from_accounts, :id, ->(a) { "#{a.name} (#{a.type.demodulize})" }, prompt: "Select an asset or liability account" %>
  </div>

  <div class="field">
    <%= f.label :memo %>
    <%= f.text_area :memo, rows: 3 %>
  </div>

  <div class="form-actions">
    <%= f.submit "Record expense", class: "btn btn-primary" %>
    <%= link_to "Cancel", expenses_path, class: "btn btn-secondary" %>
  </div>
<% end %>
