<%= form_with model: document, **document_form_options(document), class: "app-form app-form-wide" do |f| %>
  <%= render "documents/errors", document: document %>

  <% if vendors.any? %>
    <div class="field">
      <%= f.label :contact_id, "Vendor" %>
      <%= f.collection_select :contact_id, vendors, :id, :name, include_blank: "— pick a vendor or type a name below —" %>
    </div>
  <% end %>

  <%= f.fields_for :documentable, document.expense do |exp| %>
    <div class="field">
      <%= exp.label :vendor, "Vendor name (used if no vendor picked)" %>
      <%= exp.text_field :vendor, autofocus: vendors.empty? %>
    </div>

    <div class="field">
      <%= f.label :date, "Date" %>
      <%= f.date_field :date %>
    </div>

    <div class="field">
      <%= exp.label :bank_account_id, "Paid from" %>
      <%= exp.collection_select :bank_account_id, bank_accounts, :id, :display_name, prompt: "Select a bank account or card" %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :reference, "Reference (optional)" %>
    <%= f.text_field :reference %>
  </div>

  <%= render "shared/line_items_fields", form: f, accounts: expense_accounts, tax_rates: tax_rates %>

  <div class="field">
    <%= f.label :memo %>
    <%= f.text_area :memo, rows: 3 %>
  </div>

  <div class="field">
    <%= f.label :attachments, "Receipts (PDF, images)" %>
    <%= f.file_field :attachments, multiple: true %>
  </div>

  <div class="form-actions">
    <%= f.submit (document.new_record? ? "Record expense" : "Update expense"), class: "btn btn-primary" %>
    <%= link_to "Cancel", expenses_path, class: "btn btn-secondary" %>
  </div>
<% end %>
