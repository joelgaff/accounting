<header class="page-header">
  <h1>Edit deposit #<%= @document.id %></h1>
</header>

<% if @income_accounts.empty? || @bank_accounts.empty? %>
  <div class="notice">
    <p>You need an income account and a bank account before you can record a deposit.</p>
    <p><%= link_to "Import your Chart of Accounts", new_chart_of_accounts_import_path %> for accounts, and <%= link_to "add a bank account", new_bank_account_path %> under Banking.</p>
  </div>
<% else %>
  <%= render "form", document: @document, income_accounts: @income_accounts, bank_accounts: @bank_accounts, customers: @customers, tax_rates: @tax_rates %>
<% end %>
