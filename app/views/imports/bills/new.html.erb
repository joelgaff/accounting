<header class="page-header">
  <h1>Import bills from Xero</h1>
</header>

<div class="notice notice-info">
  <p>Upload Xero's <strong>Bills CSV</strong> (Business → Bills → Export). One row per line item, keyed by <code>*InvoiceNumber</code>. Re-import is safe — matches on the bill number and updates in place.</p>
  <p>Requires: your Chart of Accounts + Tax Rates imported first, and an accounts-payable account picked under <%= link_to "Settings", settings_path %>. Bills are recorded as expenses with paid_from = your AP account (i.e. accrued, not yet paid).</p>
</div>

<%= form_with url: imports_bills_path, multipart: true, class: "app-form" do |f| %>
  <div class="field">
    <%= f.label :file, "Xero Bills CSV" %>
    <%= f.file_field :file, accept: "text/csv,.csv" %>
  </div>
  <div class="form-actions">
    <%= f.submit "Import", class: "btn btn-primary" %>
    <%= link_to "Cancel", imports_path, class: "btn btn-secondary" %>
  </div>
<% end %>
