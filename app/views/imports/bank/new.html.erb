<header class="page-header">
  <h1>Import bank statement</h1>
</header>

<% if @asset_accounts.empty? %>
  <div class="notice">
    <p>You need at least one Asset account (the bank) before importing. <%= link_to "Import your Chart of Accounts first", new_chart_of_accounts_import_path %>.</p>
  </div>
<% else %>
  <div class="notice notice-info">
    <p>Upload a CSV with columns <code>Date</code>, <code>Amount</code>, and optionally <code>Description</code>, <code>Payee</code>, <code>Reference</code>. Xero's bank statement export (<code>*Date, *Amount, Payee, Description, Reference</code>) works as-is.</p>
    <p>Rows land as <strong>unmatched</strong> bank transactions. Match each to an invoice/expense, categorize inline, or ignore — the ledger post happens then, not at import.</p>
  </div>

  <%= form_with url: imports_bank_path, multipart: true, class: "app-form" do |f| %>
    <div class="field">
      <%= f.label :bank_account_id, "Bank account" %>
      <%= f.collection_select :bank_account_id, @asset_accounts, :id, ->(a) { "#{a.code} #{a.name}" }, prompt: "Select bank account" %>
    </div>
    <div class="field">
      <%= f.label :file, "CSV file" %>
      <%= f.file_field :file, accept: "text/csv,.csv" %>
    </div>
    <div class="form-actions">
      <%= f.submit "Import", class: "btn btn-primary" %>
      <%= link_to "Cancel", imports_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
<% end %>
