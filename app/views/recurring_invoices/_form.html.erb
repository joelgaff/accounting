<%= form_with model: recurring_invoice, class: "app-form", style: "max-width:none;" do |f| %>
  <% if recurring_invoice.errors.any? %>
    <div class="form-errors">
      <ul>
        <% recurring_invoice.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% if customers.any? %>
    <div class="field">
      <%= f.label :contact_id, "Customer" %>
      <%= f.collection_select :contact_id, customers, :id, :name, include_blank: "— pick a customer or type a name below —" %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :client_name, "Client name (used if no customer picked)" %>
    <%= f.text_field :client_name %>
  </div>

  <div class="field">
    <%= f.label :receivable_account_id, "Receivable account (debit)" %>
    <%= f.collection_select :receivable_account_id, receivable_accounts, :id, ->(a) { "#{a.code} #{a.name}" }, prompt: "Select AR account" %>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
    <div class="field">
      <%= f.label :frequency %>
      <%= f.select :frequency, RecurringInvoice::FREQUENCIES.map { |s| [s.titleize, s] } %>
    </div>
    <div class="field">
      <%= f.label :interval, "Every" %>
      <%= f.number_field :interval, min: 1 %>
    </div>
    <div class="field">
      <%= f.label :net_days, "Net days" %>
      <%= f.number_field :net_days, min: 0 %>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
    <div class="field">
      <%= f.label :next_run_on, "Next run" %>
      <%= f.date_field :next_run_on %>
    </div>
    <div class="field">
      <%= f.label :end_on, "End on (optional)" %>
      <%= f.date_field :end_on %>
    </div>
  </div>

  <div class="field">
    <%= f.check_box :active %> <%= f.label :active, "Active", style: "display:inline;" %>
  </div>

  <div class="field">
    <%= f.check_box :email_on_generate %>
    <%= f.label :email_on_generate, "Auto-email invoice to customer on generation (uses contact's email)", style: "display:inline;" %>
  </div>

  <%= render "shared/line_items_fields", form: f, accounts: revenue_accounts, tax_rates: tax_rates %>

  <div class="form-actions">
    <%= f.submit (recurring_invoice.new_record? ? "Create recurring invoice" : "Update recurring invoice"), class: "btn btn-primary" %>
    <%= link_to "Cancel", recurring_invoices_path, class: "btn btn-secondary" %>
  </div>
<% end %>
