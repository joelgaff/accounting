<header class="page-header">
  <div>
    <h1>Dashboard</h1>
    <p class="lede"><%= Current.organization.name %> — position as at <%= Date.current.strftime("%b %-d, %Y") %></p>
  </div>
  <div class="page-actions" style="display:flex;gap:8px;">
    <%= link_to "New invoice", new_invoice_path, class: "btn btn-primary" %>
    <%= link_to "New expense", new_expense_path, class: "btn btn-secondary" %>
  </div>
</header>

<%# Phone only: the three things you do on the go. The header buttons cover wide screens. %>
<nav class="chips quick-actions" aria-label="Quick actions">
  <%= link_to "New invoice", new_invoice_path, class: "active" %>
  <%= link_to "New expense", new_expense_path %>
  <%= link_to "Reconcile · #{@unmatched_count}", bank_transactions_path(status: "unmatched") %>
</nav>

<% if @missing_slots.any? %>
  <div class="notice">
    <p>These KPI cards aren't wired to an account yet:</p>
    <ul>
      <% @missing_slots.each do |label| %>
        <li><strong><%= label %></strong></li>
      <% end %>
    </ul>
    <p><%= link_to "Pick the accounts in Settings", settings_path %> — or <%= link_to "import your Chart of Accounts", new_chart_of_accounts_import_path %> first if it's empty.</p>
  </div>
<% end %>

<section class="kpi-grid">
  <% @kpis.each do |label, account, balance, path| %>
    <%= content_tag(path ? :a : :article, class: "kpi-card #{'kpi-link' if path}", href: path) do %>
      <div class="kpi-label"><%= label %></div>
      <div class="kpi-value">$<%= number_with_precision(balance, precision: 2, delimiter: ",") %></div>
      <div class="kpi-source">
        <% if account %>
          <code><%= account.code %></code> <%= account.name %>
        <% else %>
          <span class="muted">No account linked</span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>

<section class="panel">
  <div class="panel-head">
    <h2 class="panel-title">Recent activity</h2>
    <span class="meta">Last 10 entries</span>
  </div>

  <% if @recent_entries.any? %>
    <table class="data-table cards">
      <thead>
        <tr>
          <th>When</th>
          <th>Description</th>
          <th>Source</th>
          <th class="num">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_entries.each do |entry| %>
          <tr>
            <% target = entry_path_for(entry.commercial_document) %>
            <td class="muted" data-cell="secondary"><%= target ? link_to(entry.created_at.strftime("%Y-%m-%d %H:%M"), target, class: "muted") : entry.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td data-cell="primary"><%= target ? link_to(entry.description, target) : entry.description %></td>
            <td data-cell="secondary">
              <% if entry.commercial_document %>
                <%= target ? link_to(entry.commercial_document.label, target) : entry.commercial_document.label %>
              <% else %>
                <span class="muted">—</span>
              <% end %>
            </td>
            <% total = "$#{number_with_precision(@entry_totals[entry.id] || 0, precision: 2, delimiter: ',')}" %>
            <td class="num" data-cell="amount"><%= target ? link_to(total, target) : total %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">No ledger entries yet. Raise an invoice or record an expense to start the books.</p>
  <% end %>
</section>
