<header class="page-header">
  <div>
    <h1>Dashboard</h1>
    <p class="lede"><%= Current.organization.name %> — position as at <%= Date.current.strftime("%b %-d, %Y") %></p>
  </div>
  <div style="display:flex;gap:8px;">
    <%= link_to "New invoice", new_invoice_path, class: "btn btn-primary" %>
    <%= link_to "New expense", new_expense_path, class: "btn btn-secondary" %>
  </div>
</header>

<% if @missing_slots.any? %>
  <div class="notice">
    <p>These KPI cards aren't wired to an account yet:</p>
    <ul>
      <% @missing_slots.each do |label| %>
        <li><strong><%= label %></strong></li>
      <% end %>
    </ul>
    <p><%= link_to "Pick the accounts in Settings", settings_path %> — or <%= link_to "import your Chart of Accounts", new_chart_of_accounts_import_path %> first if it's empty.</p>
  </div>
<% end %>

<section class="kpi-grid">
  <% @kpis.each do |label, account, balance| %>
    <article class="kpi-card">
      <div class="kpi-label"><%= label %></div>
      <div class="kpi-value">$<%= number_with_precision(balance, precision: 2, delimiter: ",") %></div>
      <div class="kpi-source">
        <% if account %>
          <code><%= account.code %></code> <%= account.name %>
        <% else %>
          <span class="muted">No account linked</span>
        <% end %>
      </div>
    </article>
  <% end %>
</section>

<section class="panel">
  <div class="panel-head">
    <h2 class="panel-title">Recent activity</h2>
    <span class="meta">Last 10 entries</span>
  </div>

  <% if @recent_entries.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Description</th>
          <th>Source</th>
          <th class="num">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_entries.each do |entry| %>
          <tr>
            <td class="muted"><%= entry.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= entry.description %></td>
            <td>
              <% if entry.commercial_document %>
                <%= entry.commercial_document.label %>
              <% else %>
                <span class="muted">—</span>
              <% end %>
            </td>
            <td class="num">$<%= number_with_precision(entry.debit_amounts.sum(:amount), precision: 2, delimiter: ",") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">No ledger entries yet. Raise an invoice or record an expense to start the books.</p>
  <% end %>
</section>
