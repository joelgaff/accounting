<% received = @document.documentable.settlement_direction == :received %>

<header class="page-header">
  <h1>Record <%= received ? "payment received" : "payment made" %></h1>
</header>

<div class="notice notice-info">
  <p><strong><%= @document.label %> — <%= @document.counterparty %></strong></p>
  <p>Balance due: <strong><%= money(@document.balance_due) %></strong></p>
</div>

<%= form_with model: @payment, url: document_payments_path(@document), class: "app-form" do |f| %>
  <% if @payment.errors.any? %>
    <div class="form-errors">
      <ul>
        <% @payment.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :amount %>
    <%= f.number_field :amount, step: 0.01, min: 0 %>
  </div>

  <div class="field">
    <%= f.label :paid_on, "Payment date" %>
    <%= f.date_field :paid_on %>
  </div>

  <div class="field">
    <%= f.label :bank_account_id, received ? "Deposit into" : "Paid from bank" %>
    <%= f.collection_select :bank_account_id, @bank_accounts, :id, :display_name, prompt: "Select bank account" %>
  </div>

  <div class="field">
    <%= f.label :reference, "Reference (check #, txn id, etc.)" %>
    <%= f.text_field :reference %>
  </div>

  <div class="field">
    <%= f.label :memo %>
    <%= f.text_area :memo, rows: 2 %>
  </div>

  <div class="form-actions">
    <%= f.submit "Record payment", class: "btn btn-primary" %>
    <%= link_to "Cancel", document_path_for(@document), class: "btn btn-secondary" %>
  </div>
<% end %>
