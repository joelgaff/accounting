<div class="guest-card">
  <div class="guest-brand"><span><%= render "shared/logo_mark", size: 20 %></span><span class="guest-name"><%= app_name %></span></div>
  <h1>Sign in</h1>
  <p class="muted" style="margin:0 0 20px;font-size:12.5px;">No password. Enter your email and we'll send a 6-digit code.</p>
  <%= form_with url: session_path, method: :post, class: "app-form guest-form" do |f| %>
    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
    </div>
    <div class="form-actions">
      <%= f.submit "Email me a code", class: "btn btn-primary", style: "width:100%;" %>
    </div>
  <% end %>
</div>
