# --- Production mail: MailerSend over SMTP ---
# Add to config/environments/production.rb (use Rails credentials for the token):
#
# config.action_mailer.delivery_method = :smtp
# config.action_mailer.smtp_settings = {
#   address:    "smtp.mailersend.net",
#   port:       587,
#   user_name:  Rails.application.credentials.dig(:mailersend, :username),
#   password:   Rails.application.credentials.dig(:mailersend, :password),
#   authentication: :plain,
#   enable_starttls_auto: true
# }
# config.action_mailer.default_url_options = { host: "YOUR_DOMAIN" }
