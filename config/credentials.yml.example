# Keys Partita Doppia reads from the encrypted credentials. Copy what you need
# into `bin/rails credentials:edit`. Only RAILS_MASTER_KEY lives in the
# environment; everything else belongs here.

# Required.
secret_key_base: <64+ random hex characters: bin/rails secret>

# Required: Active Record encryption (bank feed credentials, Xero tokens).
# Generate with: bin/rails db:encryption:init
active_record_encryption:
  primary_key: <...>
  deterministic_key: <...>
  key_derivation_salt: <...>

# Where the app is served; drives allowed hosts and links in email.
app:
  host: books.example.com

# Outgoing mail (login codes, invoices). Any SMTP provider.
smtp:
  address: smtp.example.com
  port: 587
  user_name: <smtp user>
  password: <smtp password>
  from: books@example.com

# Optional: Xero. Register a Web app at developer.xero.com with the redirect
# URI https://<app.host>/settings/xero/callback and paste its keys here.
xero:
  client_id: <...>
  client_secret: <...>

# Optional: Launchpad SSO hub. Leave this block out to use the built-in
# magic-code sign-in. With it present the app trusts the hub's JWT cookie.
# launchpad:
#   base_url: https://launchpad.example.com
#   issuer: launchpad.example.com
#   cookie_domain: .example.com
# ee_jwt_secret: <shared HS256 secret with the hub>
